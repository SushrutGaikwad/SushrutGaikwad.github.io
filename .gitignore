# Quarto output
_site/
.quarto/

# Python (if you use Python in notebooks)
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
env/
venv/

# R (if applicable)
.Rhistory
.RData
.Rproj.user/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Windows
Thumbs.db

# VSCode
.vscode/

# Logs
*.log

# Environment variables
.env

/.quarto/
# Quarto's intermediate execution notebooks, including the numbered fallbacks
# (index.quarto_ipynb, index.quarto_ipynb_1, ...) left behind by interrupted renders.
**/*.quarto_ipynb*

# Site libraries
site_libs/

# Source materials for blog posts (local-only inputs: subtitles, lecture notes PDFs).
# Often copyrighted, so never commit them to this public repo. The README is tracked to
# document the convention and keep the folder present; everything else here is ignored.
_sources/*
!_sources/README.md

**/*.quarto_ipynb
